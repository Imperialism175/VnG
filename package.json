{
  "name": "vng",
  "productName": "VnG",
  "description": "ВнГ — кастомная настольная RPG в реальном времени",
  "author": "VnG",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "build:react": "tsc -b && vite build",
    "electron:dev": "electron .",
    "dist": "npm run build:react && electron-builder --win portable",
    "dist:installer": "npm run build:react && electron-builder --win nsis",
    "dist:all": "npm run build:react && electron-builder --win",
    "build": "npm run build:react",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.475.0",
    "play-dl": "^1.9.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.vng.tabletop",
    "productName": "VnG",
    "copyright": "Copyright © 2026 VnG",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "node_modules/ws/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**",
      "node_modules/ws/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VnG-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "VnG-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "VnG-${version}-setup.${ext}"
    }
  }
}
